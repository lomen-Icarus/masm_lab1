				; Лабораторная работа №1. Арифметические операции
				; Вариант 8: X = (3*A + 2*B) - C/4 + 10
				; A = 2, B = 4, C = 8  ->  X = 22

				.586
				.model flat, stdcall
				.stack 4096

				ExitProcess PROTO, dwExitCode:DWORD

 00000000			.data
 00000000 00000002		valA DD 2
 00000004 00000004		valB DD 4
 00000008 00000008		valC DD 8
 0000000C 00000000		X    DD ?

 00000000			.code
 00000000			main:
 00000000  A1 00000000 R	  mov eax, valA     ; eax = A
 00000005  6B C0 03		  imul eax, 3       ; eax = 3*A

 00000008  8B 1D 00000004 R	  mov ebx, valB     ; ebx = B
 0000000E  6B DB 02		  imul ebx, 2       ; ebx = 2*B

 00000011  03 C3		  add eax, ebx      ; eax = 3*A + 2*B
 00000013  8B C8		  mov ecx, eax      ; сохраняем скобку в ecx

 00000015  A1 00000008 R	  mov eax, valC     ; eax = C
 0000001A  99			  cdq               ; расширяем eax в edx:eax для деления
 0000001B  BB 00000004		  mov ebx, 4
 00000020  F7 FB		  idiv ebx          ; eax = C/4

 00000022  2B C8		  sub ecx, eax      ; ecx = (3*A + 2*B) - C/4
 00000024  83 C1 0A		  add ecx, 10       ; ecx = (3*A + 2*B) - C/4 + 10

 00000027  89 0D 0000000C R	  mov X, ecx        ; сохраняем результат
				  INVOKE ExitProcess, X
				END main
